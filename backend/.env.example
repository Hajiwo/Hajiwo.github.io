DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://hajiwo.github.io,http://localhost:4321,http://127.0.0.1:4321
# Production: false, a strong secret, your PythonAnywhere hostname and HTTPS origin.
CSRF_TRUSTED_ORIGINS=

# Articles email subscriptions. Enable only after configuring real email delivery.
ARTICLES_SITE_URL=https://hajiwo.github.io/articles
SUBSCRIPTIONS_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mail.de
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Remote delivery uses GitHub Actions; put the same random token in GitHub Secrets.
MAIL_DELIVERY_MODE=smtp
MAIL_WORKER_TOKEN=
