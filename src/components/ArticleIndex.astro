---
const configuredApi = import.meta.env.PUBLIC_API_BASE_URL || (import.meta.env.DEV ? 'http://127.0.0.1:8000/api/v1' : '');
const apiBase = configuredApi.replace(/\/$/, '');
---

<main id="main" class="archive" data-api-base={apiBase}>
	<section aria-labelledby="series-heading" class="series-section">
		<div class="series-header">
			<div class="series-heading-left">
				<svg class="series-heading-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<rect x="2" y="2" width="6.5" height="6.5" rx="1.5" fill="#b59a55" stroke="#b59a55" stroke-width="1" />
					<rect x="11.5" y="2" width="6.5" height="6.5" rx="1.5" stroke="#77756d" stroke-width="1.3" />
					<rect x="2" y="11.5" width="6.5" height="6.5" rx="1.5" stroke="#77756d" stroke-width="1.3" />
					<rect x="11.5" y="11.5" width="6.5" height="6.5" rx="1.5" stroke="#77756d" stroke-width="1.3" />
				</svg>
				<h2 id="series-heading"><span data-i18n-zh="系列" data-i18n-en="Series">系列</span></h2>
			</div>
		</div>
		<div class="series-divider"></div>
		<div class="series-grid"></div>
	</section>

	<section class="articles-section" aria-labelledby="articles-heading">
		<div class="article-index-status" hidden>
			<span id="article-sync-state" aria-live="polite"></span>
			<span id="result-count" role="status" data-count="0">共 0 篇</span>
		</div>

		<div class="search-box">
			<span class="search-icon" aria-hidden="true">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="7" />
					<line x1="21" y1="21" x2="16" y2="16" />
				</svg>
			</span>
			<label class="sr-only" for="article-search" data-i18n-zh="搜索文章" data-i18n-en="Search articles">搜索文章</label>
			<input id="article-search" type="search" placeholder="搜索标题..." data-i18n-placeholder-zh="搜索标题..." data-i18n-placeholder-en="Search titles..." autocomplete="off" />
			<kbd>/</kbd>
		</div>

		<ul class="article-list"></ul>

		<div id="empty-state" hidden>
			<h3 data-i18n-zh="还没有找到相关文章" data-i18n-en="No matching articles">还没有找到相关文章</h3>
			<p data-i18n-zh="换个关键词，或试试其他系列。" data-i18n-en="Try another keyword or series.">换个关键词，或试试其他系列。</p>
			<button id="reset-search" type="button" data-i18n-zh="清除筛选" data-i18n-en="Clear filters">清除筛选</button>
		</div>
	</section>
</main>

<script>
	type ArticleSummary = {
		title: string;
		title_en: string;
		slug: string;
		description: string;
		description_en: string;
		series: string | null;
		series_name: string | null;
		series_name_en: string | null;
		published_at: string;
		updated_at: string;
		reading_minutes?: number;
	};
	type SeriesSummary = {
		name: string;
		name_en: string;
		slug: string;
		description: string;
		description_en: string;
		article_count: number;
	};

	const FEATURED_METADATA: Record<string, {
		nameEn: string;
		tagZh: string;
		tagEn: string;
		subtitleZh: string;
		subtitleEn: string;
		descZh: string;
		descEn: string;
		color: string;
		iconSvg: string;
	}> = {
		'One Poem Suffices': {
			nameEn: 'One Poem Suffices',
			tagZh: '深度文章',
			tagEn: 'Deep Dive',
			subtitleZh: '一篇就够了',
			subtitleEn: 'One post is enough',
			descZh: '每篇深入一个主题，力求一篇讲透。围绕 Agent Engineering：Context Engineering、Multi-Agent、MCP、Skills。',
			descEn: 'Deep dives into Agent Engineering: Context Engineering, Multi-Agent, MCP, Skills.',
			color: '#b59a55',
			iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M7 16l3 5 10-3-3-5-10 3z" fill="#fff" stroke="#173653" stroke-width="1.2" stroke-linejoin="round" /><path d="M16 19l1.5-1.5" stroke="#173653" stroke-width="1" /><path d="M18 3c-3 1-5 4-5 8l-2 4 4-2c4 0 7-2 8-5-2-1-3-3-5-5z" fill="#b59a55" stroke="#173653" stroke-width="1.2" stroke-linejoin="round" /><path d="M18 3l-7 12" stroke="#173653" stroke-width="1.1" /></svg>`,
		},
		'Thinking in Context': {
			nameEn: 'Thinking in Context',
			tagZh: '随笔',
			tagEn: 'Essays',
			subtitleZh: '以上下文为核心的随笔',
			subtitleEn: 'Essays centered on context',
			descZh: '以上下文为核心视角，分析前沿 AI 系统的工程实践与设计哲学。',
			descEn: 'Analyzing engineering practices and design philosophies of cutting-edge AI systems through the lens of context.',
			color: '#8fb7d4',
			iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="4" stroke="#173653" stroke-width="1.5" /><rect x="6.5" y="7.5" width="11" height="9" rx="2.5" stroke="#173653" stroke-width="1.3" /><circle cx="12" cy="12" r="1.6" fill="#8fb7d4" /></svg>`,
		},
		'Zen of Harness': {
			nameEn: 'Zen of Harness',
			tagZh: '实践记录',
			tagEn: 'Practice',
			subtitleZh: 'Harness 工程实战',
			subtitleEn: 'Harness engineering in practice',
			descZh: '曾经是氛围编程之禅。当 AI Coding 的本质变成设计约束让 Agent 干活，记录 Harness Engineering 的实战心得。',
			descEn: 'From vibe coding to design constraints: practical insights from Harness Engineering.',
			color: '#5f86a6',
			iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M19 8a8.5 8.5 0 1 0 1 5" stroke="#173653" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /><rect x="10.5" y="10.5" width="3.2" height="3.2" rx="0.5" fill="#5f86a6" /></svg>`,
		},
		'Scaling 一下': {
			nameEn: 'Scaling Up',
			tagZh: '随笔',
			tagEn: 'Essays',
			subtitleZh: '碎碎念',
			subtitleEn: 'Thoughts & notes',
			descZh: '随笔式的思考笔记，关于 AI、杠杆与个人成长的一些不成熟的想法。',
			descEn: 'Reflective notes on AI, leverage, and personal growth.',
			color: '#c1a966',
			iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 19h4v-4h4v-4h4v-4h3" stroke="#173653" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /><circle cx="17.5" cy="4.5" r="2" fill="#c1a966" stroke="#173653" stroke-width="1.2" /></svg>`,
		},
	};

	const archive = document.querySelector<HTMLElement>('.archive')!;
	const input = document.querySelector<HTMLInputElement>('#article-search')!;
	const articleList = document.querySelector<HTMLUListElement>('.article-list')!;
	const seriesGrid = document.querySelector<HTMLElement>('.series-grid')!;
	const syncState = document.querySelector<HTMLElement>('#article-sync-state')!;
	const emptyState = document.querySelector<HTMLElement>('#empty-state')!;
	const emptyTitle = emptyState.querySelector<HTMLElement>('h3')!;
	const emptyDescription = emptyState.querySelector<HTMLElement>('p')!;
	const resetButton = emptyState.querySelector<HTMLButtonElement>('#reset-search')!;
	let selected = '';
	let syncInProgress = false;
	let backendUnavailable = false;

	const isEnglish = () => document.documentElement.dataset.language === 'en';
	const rows = () => [...document.querySelectorAll<HTMLElement>('[data-article]')];
	const cards = () => [...document.querySelectorAll<HTMLButtonElement>('button[data-series]')];

	const seriesInEnglish = (name: string) => FEATURED_METADATA[name]?.nameEn || ({
		'学习笔记': 'Study Notes',
		'知乎': 'Zhihu Essays',
	}[name] || name);

	const colorFor = (name: string) => {
		if (FEATURED_METADATA[name]) return FEATURED_METADATA[name].color;
		const palette = ['#8fb7d4', '#b59a55', '#5f86a6', '#c1a966'];
		const value = [...name].reduce((sum, character) => sum + (character.codePointAt(0) || 0), 0);
		return palette[value % palette.length];
	};

	function formatDate(value: string) {
		const dateObj = new Date(value);
		if (Number.isNaN(dateObj.valueOf())) return value;
		if (isEnglish()) {
			return new Intl.DateTimeFormat('en-US', {
				year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC',
			}).format(dateObj);
		}
		const y = dateObj.getUTCFullYear();
		const m = dateObj.getUTCMonth() + 1;
		const d = dateObj.getUTCDate();
		return `${y} 年 ${m} 月 ${d} 日`;
	}

	function formatReadingTime(minutes: number) {
		return isEnglish() ? `~${minutes} min` : `约 ${minutes} 分钟`;
	}

	function updateEmptyCopy() {
		if (backendUnavailable) {
			emptyTitle.textContent = isEnglish() ? 'Backend unavailable' : '后端暂时不可用';
			emptyDescription.textContent = isEnglish() ? 'Please try again in a moment.' : '请稍后刷新页面重试。';
			resetButton.hidden = true;
			return;
		}
		emptyTitle.textContent = isEnglish() ? 'No matching articles' : '还没有找到相关文章';
		emptyDescription.textContent = isEnglish() ? 'Try another keyword or series.' : '换个关键词，或试试其他系列。';
		resetButton.hidden = false;
	}

	function ensureSeriesCard(series: SeriesSummary) {
		const meta = FEATURED_METADATA[series.name];
		const nameEn = series.name_en || (meta ? meta.nameEn : seriesInEnglish(series.name));
		let card = cards().find((item) => item.dataset.series === series.name);
		if (!card) {
			card = document.createElement('button');
			card.type = 'button';
			card.className = 'series-card';
			card.dataset.series = series.name;
			card.dataset.backendSeries = 'true';
			card.setAttribute('aria-pressed', 'false');
			card.style.setProperty('--series-color', colorFor(series.name));

			const icon = document.createElement('span');
			icon.className = 'card-icon';
			icon.setAttribute('aria-hidden', 'true');
			icon.innerHTML = meta?.iconSvg || `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="4" width="16" height="16" rx="2" /><path d="M8 9h8M8 13h6M8 17h4" /></svg>`;

			const tag = document.createElement('span');
			tag.className = 'card-tag';
			const dot = document.createElement('i');
			const tagLabel = document.createElement('span');
			const tagZh = meta?.tagZh || '专题系列';
			const tagEn = meta?.tagEn || 'Collection';
			tagLabel.dataset.i18nZh = tagZh;
			tagLabel.dataset.i18nEn = tagEn;
			tagLabel.textContent = isEnglish() ? tagEn : tagZh;
			tag.append(dot, tagLabel);

			const title = document.createElement('h3');

			const desc = document.createElement('p');
			desc.className = 'card-desc';

			const bottom = document.createElement('span');
			bottom.className = 'card-bottom';
			const count = document.createElement('span');
			count.className = 'series-count';
			bottom.append(count);

			card.append(icon, tag, title, desc, bottom);
			seriesGrid.append(card);
		}

		card.style.setProperty('--series-color', colorFor(series.name));
		const title = card.querySelector<HTMLElement>('h3')!;
		title.dataset.i18nZh = series.name;
		title.dataset.i18nEn = nameEn;
		title.textContent = isEnglish() ? nameEn : series.name;
		const desc = card.querySelector<HTMLElement>('.card-desc')!;
		const descZh = series.description || meta?.descZh || `围绕「${series.name}」的文章与实践记录。`;
		const descEn = series.description_en || meta?.descEn || `Articles and experiments about ${nameEn}.`;
		desc.dataset.i18nZh = descZh;
		desc.dataset.i18nEn = descEn;
		desc.textContent = isEnglish() ? descEn : descZh;
		const count = card.querySelector<HTMLElement>('.series-count')!;
		const currentCount = series.article_count;
		count.dataset.count = String(currentCount);
		count.textContent = isEnglish()
			? `${currentCount} article${currentCount === 1 ? '' : 's'}`
			: `${currentCount} 篇`;
	}

	function upsertArticle(article: ArticleSummary) {
		const seriesName = article.series_name || article.series || (isEnglish() ? 'Uncategorized' : '未分类');
		const seriesNameEn = article.series_name_en || seriesInEnglish(seriesName);
		const titleEn = article.title_en || article.title;

		let row = rows().find((item) => item.dataset.slug === article.slug);
		if (!row) {
			row = document.createElement('li');
			row.dataset.article = '';
			row.dataset.backendArticle = 'true';
			articleList.append(row);
		}
		row.dataset.slug = article.slug;
		row.dataset.series = seriesName;
		row.dataset.publishedAt = article.published_at;
		row.dataset.search = `${article.title} ${titleEn} ${seriesName} ${seriesNameEn}`.toLowerCase();
		row.replaceChildren();

		const link = document.createElement('a');
		link.className = 'article-link';
		link.href = `/blog/article/?slug=${encodeURIComponent(article.slug)}`;

		const title = document.createElement('h3');
		title.className = 'article-title';
		title.dataset.i18nZh = article.title;
		title.dataset.i18nEn = titleEn;
		title.textContent = isEnglish() ? titleEn : article.title;

		const meta = document.createElement('div');
		meta.className = 'article-meta';

		const tag = document.createElement('span');
		tag.className = 'article-tag';
		tag.style.setProperty('--series-color', colorFor(seriesName));
		const dot = document.createElement('i');
		const tagLabel = document.createElement('span');
		tagLabel.dataset.i18nZh = seriesName;
		tagLabel.dataset.i18nEn = seriesNameEn;
		tagLabel.textContent = isEnglish() ? seriesNameEn : seriesName;
		tag.append(dot, tagLabel);

		const minutes = article.reading_minutes || Math.max(1, Math.round((article.description || '').length / 20)) || 5;
		const readingSpan = document.createElement('span');
		readingSpan.className = 'reading-time';
		readingSpan.dataset.minutes = String(minutes);
		readingSpan.textContent = formatReadingTime(minutes);

		const metaDot = document.createElement('span');
		metaDot.className = 'meta-dot';
		metaDot.textContent = '·';

		const time = document.createElement('time');
		time.dateTime = article.published_at;
		time.dataset.date = article.published_at;
		time.textContent = formatDate(article.published_at);

		meta.append(tag, readingSpan, metaDot, time);
		link.append(title, meta);
		row.append(link);
	}

	function updateCounts() {
		const counts = new Map<string, number>();
		rows().forEach((row) => counts.set(row.dataset.series || '', (counts.get(row.dataset.series || '') || 0) + 1));
		cards().forEach((card) => {
			const seriesName = card.dataset.series || '';
			const output = card.querySelector<HTMLElement>('.series-count');
			if (!output) return;
			const count = counts.get(seriesName) || parseInt(output.dataset.count || '0', 10) || 0;
			output.dataset.count = String(count);
			output.textContent = isEnglish() ? `${count} article${count === 1 ? '' : 's'}` : `${count} 篇`;
		});
	}

	function update() {
		const query = input.value.trim().toLowerCase();
		let visible = 0;
		rows().forEach((row) => {
			row.hidden = !((!selected || row.dataset.series === selected) && (row.dataset.search || '').includes(query));
			if (!row.hidden) visible += 1;
			const time = row.querySelector<HTMLTimeElement>('time[data-date]');
			if (time?.dataset.date) time.textContent = formatDate(time.dataset.date);
			const reading = row.querySelector<HTMLElement>('.reading-time');
			if (reading?.dataset.minutes) {
				reading.textContent = formatReadingTime(parseInt(reading.dataset.minutes, 10));
			}
		});
		cards().forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.series === selected)));
		const resultCount = document.querySelector<HTMLElement>('#result-count');
		if (resultCount) {
			resultCount.dataset.count = String(visible);
			resultCount.textContent = isEnglish() ? `${visible} article${visible === 1 ? '' : 's'}` : `共 ${visible} 篇`;
		}
		emptyState.hidden = visible > 0;
		updateEmptyCopy();
		updateCounts();
	}

	async function fetchAllPages<T>(url: string) {
		let next: string | null = url;
		const items: T[] = [];
		let pageCount = 0;
		while (next && pageCount < 100) {
			const response = await fetch(next, {
				cache: 'no-store',
				headers: { Accept: 'application/json' },
			});
			if (!response.ok) throw new Error(`HTTP ${response.status}`);
			const payload = await response.json();
			if (Array.isArray(payload)) {
				items.push(...payload);
				next = null;
			} else {
				items.push(...(Array.isArray(payload.results) ? payload.results : []));
				next = payload.next ? new URL(payload.next, window.location.href).toString() : null;
			}
			pageCount += 1;
		}
		return items;
	}

	async function fetchBackendContent(quiet = false) {
		const apiBase = (archive.dataset.apiBase || '').replace(/\/$/, '');
		if (!apiBase) {
			if (syncState) syncState.hidden = true;
			backendUnavailable = true;
			update();
			return;
		}
		if (syncInProgress) return;
		syncInProgress = true;
		if (syncState && !quiet) syncState.textContent = isEnglish() ? 'Syncing…' : '正在同步…';
		try {
			const refresh = Date.now();
			const [articles, backendSeries] = await Promise.all([
				fetchAllPages<ArticleSummary>(`${apiBase}/articles/?_=${refresh}`),
				fetchAllPages<SeriesSummary>(`${apiBase}/series/?_=${refresh}`),
			]);
			articleList.replaceChildren();
			seriesGrid.replaceChildren();
			backendSeries.forEach(ensureSeriesCard);
			const knownSeries = new Set(backendSeries.map((item) => item.name));
			articles.forEach((article) => {
				const name = article.series_name || article.series;
				if (name && !knownSeries.has(name)) {
					ensureSeriesCard({
						name,
						name_en: article.series_name_en || seriesInEnglish(name),
						slug: '',
						description: '',
						description_en: '',
						article_count: 0,
					});
					knownSeries.add(name);
				}
			});
			if (selected && !knownSeries.has(selected)) selected = '';
			articles.forEach(upsertArticle);
			articleList.append(...rows().sort((left, right) => Date.parse(right.dataset.publishedAt || '') - Date.parse(left.dataset.publishedAt || '')));
			if (syncState) {
				syncState.dataset.state = 'ready';
				syncState.textContent = isEnglish() ? '● Backend synced' : '● 已同步后端';
			}
			backendUnavailable = false;
			update();
		} catch {
			if (syncState) {
				syncState.dataset.state = 'offline';
				syncState.textContent = isEnglish() ? '○ Backend unavailable' : '○ 后端暂时不可用';
			}
			backendUnavailable = true;
			update();
		} finally {
			syncInProgress = false;
		}
	}

	seriesGrid.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-series]');
		if (!button) return;
		selected = selected === button.dataset.series ? '' : button.dataset.series || '';
		update();
	});

	input.addEventListener('input', update);
	document.querySelector('#reset-search')?.addEventListener('click', () => {
		selected = '';
		input.value = '';
		update();
		input.focus();
	});

	window.addEventListener('languagechange', () => {
		if (syncState) {
			if (syncState.dataset.state === 'ready') syncState.textContent = isEnglish() ? '● Backend synced' : '● 已同步后端';
			if (syncState.dataset.state === 'offline') syncState.textContent = isEnglish() ? '○ Backend unavailable' : '○ 后端暂时不可用';
		}
		updateEmptyCopy();
		update();
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey && !(event.target instanceof HTMLElement && (event.target.matches('input,textarea,select') || event.target.isContentEditable))) {
			event.preventDefault();
			input.focus();
		}
	});

	update();
	fetchBackendContent();
	window.setInterval(() => fetchBackendContent(true), 20000);
	window.addEventListener('focus', () => fetchBackendContent(true));
	document.addEventListener('visibilitychange', () => {
		if (document.visibilityState === 'visible') fetchBackendContent(true);
	});
</script>
