---
import { SITE_TITLE } from '../consts';
const about = Astro.url.pathname.startsWith('/about');
---
<a class="skip-link" href="#main">跳至正文</a>
<header class="site-header">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">✳</span>{SITE_TITLE}</a>
  <nav aria-label="主导航">
    <a href="/" aria-current={!about ? 'page' : undefined}>▤ <span>文章</span></a>
    <a href="/about/" aria-current={about ? 'page' : undefined}>♙ <span>关于</span></a>
    <a href="https://github.com/Hajiwo" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
  </nav>
</header>
