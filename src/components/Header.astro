---
import { SITE_TITLE } from '../consts';
import Logo from '../img/logo.png';
const about = Astro.url.pathname.startsWith('/about');
const projects = Astro.url.pathname.startsWith('/projects');
const articles = !about && !projects;
---
<a class="skip-link" href="#main" data-i18n-zh="跳至正文" data-i18n-en="Skip to content">跳至正文</a>
<header class="site-header">
  <a class="brand" href="/">
    <img class="brand-logo" src={Logo.src} alt="" width="42" height="42" />
    <span class="brand-text">{SITE_TITLE}</span>
  </a>
  <nav aria-label="主导航" data-i18n-aria-label-zh="主导航" data-i18n-aria-label-en="Main navigation">
    <a href="/projects/" class="nav-item" data-nav="projects" aria-current={projects ? 'page' : undefined}>
      <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 7.5h6l2-2h8v13H4z"/><path d="M8 12h8M8 15h5"/>
      </svg>
      <span data-i18n-zh="项目" data-i18n-en="Projects">项目</span>
    </a>
    <a href="/" class="nav-item" data-nav="articles" aria-current={articles ? 'page' : undefined}>
      <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="16" y1="13" x2="8" y2="13"/>
        <line x1="16" y1="17" x2="8" y2="17"/>
      </svg>
      <span data-i18n-zh="文章" data-i18n-en="Articles">文章</span>
    </a>
    <a href="/about/" class="nav-item" aria-current={about ? 'page' : undefined}>
      <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="8" r="4" fill="#b59a55" stroke="currentColor" />
        <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2" />
      </svg>
      <span data-i18n-zh="关于" data-i18n-en="About">关于</span>
    </a>
    <a href="https://github.com/Hajiwo" target="_blank" rel="noopener noreferrer" class="nav-item">
      <svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="6" cy="6" r="2.5" />
        <circle cx="18" cy="6" r="2.5" />
        <circle cx="12" cy="18" r="2" fill="#b59a55" stroke="currentColor" />
        <path d="M6 8.5v3a4 4 0 0 0 4 4h4a4 4 0 0 0 4-4v-3" />
        <line x1="12" y1="15" x2="12" y2="16" />
      </svg>
      <span>GitHub</span>
    </a>
    <button id="language-toggle" class="language-toggle" type="button" aria-label="Switch to English">EN</button>
  </nav>
</header>
<script>
	function applyLanguage(language: 'zh' | 'en', persist = true) {
		document.documentElement.dataset.language = language;
		document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
		document.querySelectorAll<HTMLElement>('[data-i18n-zh][data-i18n-en]').forEach((element) => {
			element.textContent = element.dataset[language === 'zh' ? 'i18nZh' : 'i18nEn'] || '';
		});
		document.querySelectorAll<HTMLElement>('[data-i18n-placeholder-zh][data-i18n-placeholder-en]').forEach((element) => {
			element.setAttribute('placeholder', element.dataset[language === 'zh' ? 'i18nPlaceholderZh' : 'i18nPlaceholderEn'] || '');
		});
		document.querySelectorAll<HTMLElement>('[data-i18n-aria-label-zh][data-i18n-aria-label-en]').forEach((element) => {
			element.setAttribute('aria-label', element.dataset[language === 'zh' ? 'i18nAriaLabelZh' : 'i18nAriaLabelEn'] || '');
		});
		document.querySelectorAll<HTMLTimeElement>('time[data-date]').forEach((element) => {
			const date = new Date(element.dataset.date || '');
			if (!Number.isNaN(date.valueOf())) {
				element.textContent = new Intl.DateTimeFormat(language === 'zh' ? 'zh-CN' : 'en-US', {
					year: 'numeric', month: language === 'zh' ? 'long' : 'short', day: 'numeric', timeZone: 'UTC',
				}).format(date);
			}
		});
		const toggle = document.querySelector<HTMLButtonElement>('#language-toggle');
		if (toggle) {
			toggle.textContent = language === 'zh' ? 'EN' : '中文';
			toggle.setAttribute('aria-label', language === 'zh' ? 'Switch to English' : '切换到中文');
			toggle.title = language === 'zh' ? 'Switch to English' : '切换到中文';
		}
		if (persist) localStorage.setItem('site-language', language);
		window.dispatchEvent(new CustomEvent('languagechange', { detail: { language } }));
	}

	const initial = document.documentElement.dataset.language === 'en' ? 'en' : 'zh';
	applyLanguage(initial, false);
	document.querySelector('#language-toggle')?.addEventListener('click', () => {
		applyLanguage(document.documentElement.dataset.language === 'zh' ? 'en' : 'zh');
	});
</script>
